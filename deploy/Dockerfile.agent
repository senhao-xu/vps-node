# syntax=docker/dockerfile:1

ARG GO_VERSION=1.25

FROM golang:${GO_VERSION} AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
ENV CGO_ENABLED=0
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -tags with_quic,with_utls -trimpath -ldflags "-s -w" -o /out/panel-agent ./cmd/agent

FROM scratch
COPY --from=build /out/panel-agent /usr/local/bin/panel-agent
COPY --from=build /etc/ssl/certs/ca-certificates.crt /etc/ssl/certs/ca-certificates.crt
ENV AGENT_STATE_PATH=/var/lib/panel-agent/state.json
VOLUME /var/lib/panel-agent
ENTRYPOINT ["/usr/local/bin/panel-agent"]
