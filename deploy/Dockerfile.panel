# syntax=docker/dockerfile:1

ARG GO_VERSION=1.25

FROM node:22-alpine AS ui
ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

FROM golang:${GO_VERSION} AS build
ARG TARGETOS
ARG TARGETARCH
WORKDIR /src
ENV CGO_ENABLED=0
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY --from=ui /src/web/dist internal/webui/dist
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -tags embed_ui -trimpath -ldflags "-s -w" -o /out/panel ./cmd/panel
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build -trimpath -ldflags "-s -w" -o /out/panel-healthcheck ./cmd/panel-healthcheck

FROM scratch
COPY --from=build /out/panel /panel
COPY --from=build /out/panel-healthcheck /panel-healthcheck
ENV PANEL_DB_PATH=/data/panel.db \
    PANEL_LISTEN=":8080"
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/panel-healthcheck"]
ENTRYPOINT ["/panel"]
