[Unit]
Description=vps-node Panel Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=panel-agent
Group=panel-agent
ExecStart=/usr/local/bin/panel-agent -config /etc/panel-agent/agent.yaml
ConfigurationDirectory=panel-agent
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
Restart=on-failure
RestartSec=5
LimitNOFILE=65535

# The agent embeds sing-box and binds node listen ports directly, so it needs
# CAP_NET_BIND_SERVICE to serve nodes on ports <=1024 (e.g. VLESS on 443).
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
