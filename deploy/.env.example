# Copy to `.env` next to the compose file (auto-loaded by docker compose) and fill in.
# Never commit `.env` — it is git-ignored and docker-ignored.

# --- Panel (docker-compose.yml / docker-compose.all-in-one.yml) ---
# 32-byte hex key that encrypts protocol secrets at rest; required.
PANEL_APP_KEY=change-me-openssl-rand-hex-32
# Bootstrap admin password; required on first start.
PANEL_ADMIN_PASSWORD=change-me
# Host port for the admin UI (container always listens on 8080).
PANEL_PORT=8080
PANEL_LOG_LEVEL=info

# --- Agent (agent.docker-compose.yml / docker-compose.all-in-one.yml) ---
# Panel URL the agent dials; use https:// in production (TLS terminates at your reverse proxy).
AGENT_PANEL_URL=https://panel.example.com
# Server id shown in the panel; required.
AGENT_SERVER_ID=1
# Provide exactly one of the two (register token = one-time, from the server detail page).
AGENT_REGISTER_TOKEN=
AGENT_TOKEN=
# Host port published for the first node (tcp+udp).
NODE_PORT=8388
AGENT_LOG_LEVEL=info
# Image override for node deployments that pull a prebuilt image.
AGENT_IMAGE=vps-node-agent:latest
