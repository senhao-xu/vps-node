# Copy to `.env` next to the compose file (auto-loaded by docker compose) and fill in.
# Never commit `.env` — it is git-ignored and docker-ignored.

# --- Panel (docker-compose.yml / docker-compose.ghcr.yml) ---
# Optional: 32-byte hex key that encrypts protocol secrets at rest.
# Leave empty to auto-generate one on first boot (persisted in the database volume).
# PANEL_APP_KEY=
# Bootstrap admin password; required on first start.
PANEL_ADMIN_PASSWORD=change-me
# Host port for the admin UI (container always listens on 8080).
PANEL_PORT=8080
PANEL_LOG_LEVEL=info
# git revision baked into the UI footer (set to the short sha at deploy time).
APP_VERSION=dev
# Image override to pull a prebuilt panel image instead of building locally.
# PANEL_IMAGE=ghcr.io/<owner>/vps-node-panel:latest

# --- Agent (agent.docker-compose.yml) ---
# Start the panel first and create a Server there; these values come from its Server
# detail page (generate the Agent Key, then copy them). The agent cannot be started
# before the panel issues its key.
# Panel URL the agent dials; use https:// in production (TLS terminates at your reverse proxy).
AGENT_PANEL_URL=https://panel.example.com
# Server id shown in the panel; required.
AGENT_SERVER_ID=1
# Long-lived agent key from the server detail page; required. The agent is stateless,
# so no volume is mounted and the key is the only identity you need to keep.
AGENT_KEY=
# Host port published for the first node (tcp+udp).
NODE_PORT=8388
AGENT_LOG_LEVEL=info
# Image override for node deployments that pull a prebuilt image.
AGENT_IMAGE=vps-node-agent:latest
